# Drop — copy to .env and fill values

DROP_ENV=local
DJANGO_SECRET_KEY=dev-insecure-change-me

# Optional — leave empty to hide Google on /login
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

OPENAI_API_KEY=
GEMINI_API_KEY=

# LLM contracts: provider:model per use case. Fallbacks are in code.
LLM_OVERVIEW=openai:gpt-5.6-luna
LLM_INSIGHTS=openai:gpt-5.6-luna
LLM_CHAT=openai:gpt-5.6-luna
LLM_CHARTS=openai:gpt-5.6-luna

# Abuse limits (per hour). Overview anônimo continua grátis (ADR-009).
RATE_LIMIT_ANON_UPLOAD_PER_HOUR=10
RATE_LIMIT_AUTH_UPLOAD_PER_HOUR=30
RATE_LIMIT_AI_JOBS_PER_HOUR=40
RATE_LIMIT_INTEREST_PER_HOUR=5
